{
    "cli": {
        "version": ">= 18.0.6",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development"
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview"
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "ios": { "image": "latest" }
        }
    },
    "submit": {
        "production": {
            "android": {
                "serviceAccountKeyPath": "./credentials/google-play-service-account.json",
                "track": "internal",
                "releaseStatus": "draft"
            },
            "ios": {
                "ascApiKeyPath": "./credentials/app-store-connect-api-key.p8",
                "ascApiKeyIssuerId": "f1d53ae5-ddc6-4a42-b842-decb7a445842",
                "ascApiKeyId": "34RKPZ9Z3U"
            }
        }
    }
}
